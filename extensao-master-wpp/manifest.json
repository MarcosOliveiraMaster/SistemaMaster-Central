{
  "manifest_version": 3,
  "name": "Master WhatsApp App",
  "version": "0.1.0",
  "description": "Envia mensagens automaticamente via WhatsApp Web a partir de comandos do SistemaMaster Central.",
  "key": "",
  "permissions": ["clipboardRead", "tabs", "scripting", "storage"],
  "background": {
    "service_worker": "app/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["app/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": ["http://localhost:8123"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
