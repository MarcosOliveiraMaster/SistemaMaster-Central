rules_version = '2';

// Firebase Storage — Master Educação
//
// NÃO ATIVO NO MOMENTO. O projeto está no plano Spark, e criar o bucket de Cloud
// Storage for Firebase (Storage > Vamos começar, no Console) hoje exige plano Blaze.
// Por isso o envio de foto de perfil de professores (dashboardProfessores.js /
// GaleriaProfessores) foi revertido pra salvar a foto como data URL base64 direto
// no Firestore (ver CFG.campoFoto no próprio arquivo), sem usar Storage.
//
// Este arquivo fica guardado pronto pra quando o projeto migrar pro Blaze: nessa
// hora, é só criar o bucket, reativar "storage": {"rules": "storage.rules"} em
// firebase.json, rodar `firebase deploy --only storage`, aplicar o cors.json da
// raiz (`gsutil cors set cors.json gs://<bucket>`) e trocar o front-end de volta
// pra usar S.storage.ref().put() em vez de salvar base64 no Firestore.
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de perfil dos professores — exibidas publicamente nos cards da
    // Galeria de Professores (<img src>), por isso leitura é liberada.
    // Escrita só para e-mails autorizados do painel administrativo (mesma
    // whitelist usada nas regras do Firestore e em functions/index.js).
    match /fotos-professores/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email in [
          'mastereducacaoadm@gmail.com',
          'marcos.lucas.ti@gmail.com'
        ];
    }

    // Bloqueia tudo o mais por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
